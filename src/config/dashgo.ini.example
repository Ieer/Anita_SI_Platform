[CommonConf]
# Generate 32 random bytes and encode as 64 hexadecimal characters.
ENCRYPT_KEY=REPLACE_WITH_64_HEX_CHARACTERS
DASH_SERVE_LOCALLY=True

[FlaskConf]
COMPRESS_ALGORITHM=br
COMPRESS_BR_LEVEL=9
COOKIE_SESSION_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET

[LoginConf]
VERIFY_CODE_SHOW_LOGIN_FAIL_COUNT=5
VERIFY_CODE_CHAR_NUM=4
JWT_EXPIRED_FORCE_LOGOUT=False

[LogConf]
LOG_LEVEL=INFO
HANDLER_CONSOLE=True
HANDLER_LOG_FILE=True
LOG_FILE_PATH=./DashGo.log
MAX_MB_PER_LOG_FILE=50
MAX_COUNT_LOG_FILE=3

[ShowConf]
WEB_TITLE=SI-Platform
APP_NAME=SI-Platform

[JwtConf]
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

[SqlDbConf]
RDB_TYPE=sqlite
SQLITE_DB_PATH=../app.db
HOST=127.0.0.1
PORT=3306
USER=app
PASSWORD=CHANGE_ME_FOR_MYSQL
DATABASE=app
POOL_SIZE=5

[ProxyConf]
NGINX_PROXY=False

[OAuth2Conf]
OAuth2AuthorizationCodeExpiresInMinutes=60
OAuth2AuthorizationCodeLength=32
OAuth2TokenExpiresInMinutes=120

[ApSchedulerConf]
DATA_EXPIRE_DAY=90
HOST=127.0.0.1
PORT=8091
MISFIRE_GRACE_TIME_SECONDS=300

[ListenTaskConf]
PERIOD_MINTUES=1