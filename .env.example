# Optional environment variables read directly by SI-Platform.
# This file is an example only; the application does not load dotenv files.
# Set variables in the process environment before starting scripts/start_ap.py.

# Only for unattended FIRST database initialization; otherwise use the hidden terminal prompt.
# Inject a unique 16-1024 character password from a secret manager, then unset it.
# Existing administrators are never reset. Do not put a real value in this file.
# SMART_AGENT_INITIAL_ADMIN_PASSWORD=

# Required when starting or connecting to the separate scheduler service.
# Generate at least 32 random UTF-8 bytes; use the same value for Web and scheduler.
SMART_AGENT_SCHEDULER_RPC_SECRET=

# Optional OpenAI-compatible Agent configuration. Leave the API key empty to disable it.
SMART_AGENT_PROVIDER=openai_compatible
SMART_AGENT_BASE_URL=https://api.openai.com/v1
SMART_AGENT_MODEL=
SMART_AGENT_API_KEY=
# Optional trusted Python module for registering non-OpenAI-compatible Providers.
# SMART_AGENT_PROVIDER_MODULE=your_package.vendor_agent_provider

# Optional built-in Internal Agent API Provider (no extension module required).
# Set SMART_AGENT_PROVIDER=internal_agent and SMART_AGENT_BASE_URL to the v5 service root.
# SMART_AGENT_API_KEY is the APIM Subscription Key; SMART_AGENT_MODEL may be empty.
# SMART_AGENT_INTERNAL_AGENT_AGENT_ID=
# SMART_AGENT_INTERNAL_AGENT_TENANT_ID=
# SMART_AGENT_INTERNAL_AGENT_CLIENT_ID=
# SMART_AGENT_INTERNAL_AGENT_CLIENT_SECRET=
# SMART_AGENT_INTERNAL_AGENT_SCOPE=

# Optional Enterprise Models: same-machine, read-only enterprise AI sign-in file.
# All four values are required. OWNER is a single existing platform admin username.
# Set the actual source timezone explicitly; the example is not a detected timezone.
# TOKEN_FILE is an absolute deployment-local path, never a browser input or upload.
# Replace the reserved example URL with the approved complete HTTPS streaming endpoint.
# SMART_AGENT_ENTERPRISE_MODELS_ENDPOINT=https://enterprise-api.example.com/v1/chat/stream
# SMART_AGENT_ENTERPRISE_MODELS_TOKEN_FILE=C:\ProgramData\EnterpriseAI\Data\token.dat
# SMART_AGENT_ENTERPRISE_MODELS_OWNER=
# SMART_AGENT_ENTERPRISE_MODELS_TOKEN_TIMEZONE=Asia/Shanghai
# Create an Enterprise Models profile in Agent Connections; no API key is stored.
# For environment-only configuration, use SMART_AGENT_PROVIDER=enterprise_models,
# and an approved SMART_AGENT_MODEL. The dedicated ENDPOINT overrides SMART_AGENT_BASE_URL.

# Agent task approval is disabled by default. Set an explicit JSON array of task IDs to enable.
SMART_AGENT_RUN_ALLOWLIST=[]

# Optional browser page assistant override. When empty, the vendored page-agent 1.12.4
# asset is served locally by Dash and works without internet access.
# Use only an approved, fixed HTTPS intranet asset when overriding.
# SMART_AGENT_PAGE_AGENT_URL=https://<approved-host>/page-agent.<version>.js
